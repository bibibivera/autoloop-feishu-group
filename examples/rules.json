{
  "sources": {
    "local": { "name": "本机" },
    "feishu-group": { "name": "飞书群" }
  },
  "agents": {
    "codex": { "name": "Codex", "worker": "this-machine", "use": "codex", "access": "read", "effort": "medium" }
  },
  "channels": {
    "desktop": { "name": "桌面通知" },
    "group": { "name": "飞书群", "answerers": ["ou_你自己的 open_id"] }
  },
  "defaultChannels": ["group"],
  "rules": [
    {
      "name": "广告巡检",
      "when": { "cron": "0 9 * * *" },
      "to": "codex",
      "cwd": "~/Desktop/运营助手",
      "prompt": "先读 skills/广告巡检.md 和 知识库.md，严格照做。"
    },
    {
      "name": "群里问答",
      "when": { "source": "feishu-group", "types": ["feishu.mention"] },
      "to": "codex",
      "cwd": "~/Desktop/运营助手",
      "prompt": "先读 skills/群里问答.md 和 知识库.md，严格照做。",
      "parallel": 3,
      "resume": true
    }
  ],
  "elsewhere": []
}
